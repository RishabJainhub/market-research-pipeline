# ============================================
# Market Research Pipeline — Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys.
# Never commit your .env file to version control.

# Tavily Search API (Market sizing & real-time discovery)
# Get your key at: https://tavily.com
TAVILY_API_KEY=tvly-your-api-key-here

# Groq LLM API (LLaMA 3.3 70B ultra-fast analytical synthesis)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your-api-key-here

# Perplexity Sonar API (Deep quantitative citations & macro telemetry)
# Get your key at: https://docs.perplexity.ai
PERPLEXITY_API_KEY=pplx-your-api-key-here

# Google Workspace Integration (Docs / Sheets / Drive)
# Configured via n8n Google OAuth2 / Service Account credentials
# GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
# GOOGLE_DOCS_FOLDER_ID=your_docs_folder_id_here

# Gmail / Email Delivery
# Configured via n8n OAuth2 credential directly in workflow
